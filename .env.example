# Copy this file to ".env" and fill in your own values.
# The .env file is NOT committed to the repository (it is in .gitignore).

# Email
GMAIL_USER=iviivilaca@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
ALERT_TO=iviivilaca@gmail.com

# LLM (utils/llm.py). Only needed for the gemini/* models: a local Ollama
# model needs no key, just a running server.
GEMINI_API_KEY=your_gemini_api_key
# Overrides the default model, e.g. ollama/gemma3:1b
# LLM_MODEL=gemini/gemini-flash-latest
